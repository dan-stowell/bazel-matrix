module(name = "bazel_matrix")

bazel_dep(name = "rules_python", version = "2.4.5")

# One source repo per project in projects.json; see tools/sources.bzl.
projects = use_extension("//tools:sources.bzl", "projects")
use_repo(projects, "projects")

# The BuildBuddy API key for the inner Bazels; see tools/credentials.bzl.
buildbuddy_credentials = use_repo_rule("//tools:credentials.bzl", "buildbuddy_credentials")

buildbuddy_credentials(name = "buildbuddy_credentials")
