# The RBE image canary; see README.md. Not a project package: the probes are
# manual, so //... and the matrix skip them; tls_probe_unit_test is a plain
# unit test of the probe's parsing.

load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# tls_probe_test runs on an RBE executor, in the container-image of
# tools/remote.bazelrc; tls_probe_runner_test on the bb remote runner, in
# its --container_image (tools/bb.sh passes the same image).
[
    sh_test(
        name = name,
        size = "medium",
        srcs = ["tls_probe.sh"],
        data = [
            "emudhra.txt",
            "emudhra_chain.pem",
            "tls_probe.py",
        ] + glob(["roots/*.txt"]),
        tags = [
            "external",
            "manual",
        ] + extra_tags,
    )
    for name, extra_tags in [
        ("tls_probe_test", []),
        ("tls_probe_runner_test", ["no-remote-exec"]),
    ]
]

py_test(
    name = "tls_probe_unit_test",
    srcs = [
        "tls_probe.py",
        "tls_probe_unit_test.py",
    ],
    imports = ["."],
)

# Unit tests of server.py, the app that runs the canary.
py_test(
    name = "server_test",
    srcs = [
        "server.py",
        "server_test.py",
    ],
    data = ["//tools:remote.bazelrc"],
    imports = ["."],
)
