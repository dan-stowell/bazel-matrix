# Run everything on BuildBuddy RBE with --config=remote-minimal; see
# README.md. tools/sync.py reads the image from tools/remote.bazelrc.
import %workspace%/tools/remote.bazelrc

# Keep reproducible repos (the project sources) in the remote cache.
startup --experimental_remote_repo_contents_cache

# Keep going so one broken project doesn't hide the rest.
common --keep_going

# The outer graph is a handful of rules_python repos and generated repos.
common --lockfile_mode=off

# `test //...` runs each project's inner test, which builds everything the
# inner build would; don't also run the inner builds.
test --build_tests_only
test --test_output=errors
