# Run everything on BuildBuddy RBE with --config=remote-minimal; see
# README.md. tools/bb.sh reads the image from tools/remote.bazelrc.
import %workspace%/tools/remote.bazelrc

# Keep reproducible repos (the project sources) in the remote cache.
startup --experimental_remote_repo_contents_cache

# Keep going so one broken project doesn't hide the rest.
common --keep_going

# The outer graph is a handful of rules_python repos and generated repos.
common --lockfile_mode=off

# `test //...` runs each project's inner test, which builds everything the
# inner build would; don't also run the inner builds.
test --build_tests_only
test --test_output=errors

# Inner Bazels on RBE (README.md, "Inner Bazels on RBE"): each project's
# :test runs on an executor in the image of tools/remote.bazelrc. Also pass
# the API key header from a 0600 rc file outside the repo (README.md).
common:inner-remote --//:inner_remote
common:inner-remote --remote_default_exec_properties=EstimatedCPU=4
common:inner-remote --remote_default_exec_properties=EstimatedMemory=8GB
common:inner-remote --remote_default_exec_properties=EstimatedFreeDiskBytes=20GB
# The same on arm64 executors: the outer targets (and runs the tests on)
# arm64, and so do the inner Bazels' actions.
common:inner-remote-arm64 --config=inner-remote
common:inner-remote-arm64 --platforms=//tools:linux_arm64
common:inner-remote-arm64 --extra_execution_platforms=//tools:linux_arm64
common:inner-remote-arm64 --remote_default_exec_properties=Arch=arm64
common:inner-remote-arm64 --//:inner_flags=--remote_default_exec_properties=Arch=arm64
