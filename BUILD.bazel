# Root package. Projects live in //<module>/; see README.md.

load("//tools:project.bzl", "bool_setting", "string_list_setting", "string_setting")
load("//tools:versions.bzl", "DEFAULT_INNER_BAZEL")

exports_files(
    [
        "projects.json",
        "projects.txt",
    ],
    visibility = ["//tools:__pkg__"],
)

# Extra flags for every inner Bazel, e.g.
# --//:inner_flags=--test_tag_filters=-slow (repeat it for more flags).
string_list_setting(
    name = "inner_flags",
    build_setting_default = [],
    visibility = ["//visibility:public"],
)

# The inner Bazel for projects that don't pin one; one of
# tools/versions.bzl's INNER_BAZELS.
string_setting(
    name = "inner_bazel_version",
    build_setting_default = DEFAULT_INNER_BAZEL,
    visibility = ["//visibility:public"],
)

# Run each project's :test on an RBE executor (in the image and arch under
# test) instead of on the machine running the outer Bazel; see README.md.
bool_setting(
    name = "inner_remote",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)
