load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("@projects//:modules.bzl", "GENERATED", "MODULES")
load(":versions.bzl", "INNER_BAZELS")

exports_files([
    "buildbuddy_credential_helper.py",
    "inner.bazelrc",
    "remote.bazelrc",
])

# Which pinned inner Bazel --//:inner_bazel_version selects.
[
    config_setting(
        name = "inner_bazel_" + v,
        flag_values = {"//:inner_bazel_version": v},
    )
    for v in INNER_BAZELS
]

py_binary(
    name = "inner_bazel",
    srcs = ["inner_bazel.py"],
)

py_test(
    name = "inner_bazel_test",
    srcs = [
        "inner_bazel.py",
        "inner_bazel_test.py",
    ],
    imports = ["."],
)

py_test(
    name = "sync_test",
    srcs = [
        "sync.py",
        "sync_test.py",
    ],
    imports = ["."],
)

# Fails when the committed projects.json, docs/coverage.md or projects/<module>/BUILD.bazel files
# don't match projects.txt, i.e. when sync wasn't re-run.
py_test(
    name = "generated_test",
    srcs = [
        "generated_test.py",
        "sync.py",
    ],
    data = [
        "//:docs/coverage.md",
        "//:projects.json",
        "//:projects.txt",
    ] + ["//projects/%s:BUILD.bazel" % m for m in MODULES + [g for g in GENERATED if g not in MODULES]],
    env = {"GENERATED": " ".join(GENERATED)},
    imports = ["."],
)

py_test(
    name = "buildbuddy_credential_helper_test",
    srcs = [
        "buildbuddy_credential_helper.py",
        "buildbuddy_credential_helper_test.py",
    ],
    imports = ["."],
)

py_test(
    name = "run_test",
    srcs = [
        "run.py",
        "run_test.py",
        "sync.py",
    ],
    imports = ["."],
)
