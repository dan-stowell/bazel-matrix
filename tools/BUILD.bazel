load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@projects//:modules.bzl", "GENERATED", "MODULES")
load(":versions.bzl", "INNER_BAZELS")

exports_files([
    "buildbuddy_credential_helper.py",
    "inner.bazelrc",
    "remote.bazelrc",
])

# Which pinned inner Bazel --//:inner_bazel_version selects.
[
    config_setting(
        name = "inner_bazel_" + v,
        flag_values = {"//:inner_bazel_version": v},
    )
    for v in INNER_BAZELS
]

# The same, when the target cpu is aarch64: the linux-arm64 inner Bazel.
[
    config_setting(
        name = "inner_bazel_%s_arm64" % v,
        constraint_values = ["@platforms//cpu:aarch64"],
        flag_values = {"//:inner_bazel_version": v},
    )
    for v, info in INNER_BAZELS.items()
    if info.arm64_sha256
]

config_setting(
    name = "aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
)

# --//:inner_remote: the projects' tests run on RBE; see README.md.
config_setting(
    name = "inner_remote",
    flag_values = {"//:inner_remote": "true"},
)

# An arm64 executor, for --config=inner-remote-arm64 (target and execution
# platform). No exec_properties: those would replace
# --remote_default_exec_properties (the image of tools/remote.bazelrc), so
# the config adds Arch=arm64 there instead.
platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

py_binary(
    name = "inner_bazel",
    srcs = ["inner_bazel.py"],
)

# tools/inner_bazel.py for a test running on RBE (--//:inner_remote). Run
# with the image's python3, not as a py_binary: rules_python's py_binary
# needs a zipper built for the executor, so a C++ toolchain for arm64.
sh_binary(
    name = "remote_inner_bazel",
    srcs = ["remote_inner_bazel.py"],
    data = ["inner_bazel.py"],
)

# The runner of the projects' :test.
alias(
    name = "test_runner",
    actual = select({
        ":inner_remote": ":remote_inner_bazel",
        "//conditions:default": ":inner_bazel",
    }),
)

py_test(
    name = "inner_bazel_test",
    srcs = [
        "inner_bazel.py",
        "inner_bazel_test.py",
    ],
    imports = ["."],
)

py_test(
    name = "sync_test",
    srcs = [
        "sync.py",
        "sync_test.py",
    ],
    imports = ["."],
)

# Fails when the committed projects.json or <module>/BUILD.bazel files
# don't match projects.txt, i.e. when sync wasn't re-run.
py_test(
    name = "generated_test",
    srcs = [
        "generated_test.py",
        "sync.py",
    ],
    data = [
        "//:projects.json",
        "//:projects.txt",
    ] + ["//%s:BUILD.bazel" % m for m in MODULES + [g for g in GENERATED if g not in MODULES]],
    env = {"GENERATED": " ".join(GENERATED)},
    imports = ["."],
)

py_test(
    name = "buildbuddy_credential_helper_test",
    srcs = [
        "buildbuddy_credential_helper.py",
        "buildbuddy_credential_helper_test.py",
    ],
    imports = ["."],
)

py_test(
    name = "run_test",
    srcs = [
        "run.py",
        "run_test.py",
        "sync.py",
    ],
    imports = ["."],
)
